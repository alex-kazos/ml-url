# Data Paths Configuration
DATA_ROOT=Data
RAW_DATA_PATH=Data/raw
PROCESSED_DATA_PATH=Data/processed

# File Names
UCI_PHISHING_FILE=phishing_url_uci.pkl
KAGGLE_PHISHING_FILE=phishing_site_urls.csv
KAGGLE_TOP_SEARCHES_FILE=top-1m.csv

# UCI Repository Configuration
UCI_PHISHING_REPO_ID=967

# Kaggle Datasets
KAGGLE_PHISHING_SITE_URLS=taruntiwarihp/phishing-site-urls
KAGGLE_TOP_1M=cheedcheed/top1m

# MLflow configuration (empty = local SQLite file mlflow.db in the project root)
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_NAME=Phishing URL Detection
MLFLOW_MODEL_NAME=ml-url

# Champion / challenger promotion
PROMOTION_METRIC=F1-Score
PROMOTION_MIN_IMPROVEMENT=0.002
PROMOTION_RECALL_TOLERANCE=0.005
MAX_BUNDLE_MB=50
EVAL_SAMPLE_SIZE=2000
GOLDEN_SET_MIN_ACCURACY=0.75

# Public API configuration
# Comma-separated list, e.g. https://example.com,https://www.example.com
API_ALLOWED_ORIGINS=http://localhost:5173
API_MODEL_NAME=XGBoost
# Set a token to require "Authorization: Bearer <token>" on /metrics
METRICS_TOKEN=
