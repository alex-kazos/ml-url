# Ignore data folders and raw/processed dataset files
/Data/
/Data/**

# Ignore pickled data and model artifacts
*.pkl
*.pickle
Models/*.pkl
Models/*_confusion_matrix.png
Models/*_roc_curve.png
Models/*_feature_importance.png
!Models/XGBoost.pkl
!Models/champion.pkl
models/*.joblib
*.joblib

# Python caches and compiled files
__pycache__/
*.pyc
*.pyo

# Test, lint and notebook artifacts
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.ipynb_checkpoints/**

# Virtual environments and environment files
.venv/
venv/
env/
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage reports
htmlcov/
.coverage

# Build/dist
dist/
build/

# Temporary files
*.swp
*~

# MLflow tracking artifacts
mlruns/
**/mlruns/
mlartifacts/
**/mlartifacts/
mlflow.db
**/mlflow.db
# SQLite journal/WAL files written next to mlflow.db during a run
mlflow.db-*
# Old file-store runs set aside when moving to mlflow.db (e.g. mlruns_old/)
mlruns_*/

# Monitoring secrets: bearer token Prometheus uses to scrape the Render /metrics
monitoring/prometheus/metrics_token
