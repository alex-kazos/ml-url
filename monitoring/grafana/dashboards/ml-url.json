          "legendFormat": "last 15 min",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mlurl_predictions_total{verdict=\"phishing\"}[6h])) / sum(rate(mlurl_predictions_total[6h]))",
