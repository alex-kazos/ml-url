      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mlurl_model_info",
          "legendFormat": "{{algorithm}} \u00b7 v{{version}}",
          "refId": "A"
