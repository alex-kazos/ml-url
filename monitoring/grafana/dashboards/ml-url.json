    {
      "id": 11,
      "type": "heatmap",
      "title": "Phishing probability distribution",
      "description": "Model-output drift: watch for mass moving between buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(mlurl_phishing_probability_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "percentunit"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
